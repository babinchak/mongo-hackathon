  "ts": "2026-02-26T19:07:02Z",
  "text": "The streaming path encrypts each 4 MiB chunk with AES-GCM using the file's single IV. Reusing an IV under the same key breaks GCM. I'll derive a per-chunk nonce from a random 8-byte prefix plus a 4-byte chunk counter and store the prefix in the file header.",
  "durable": false,
  "superseded_at": "9999-12-31T00:00:00Z",
  "role": "assistant",
  "pushback": null,
  "noise": false
